# PixelCake Backend - Environment Configuration
# Copia questo file in .env e personalizza i valori

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Development (SQLite - zero setup, file-based)
DATABASE_URL=sqlite+aiosqlite:///./database.db

# Production (PostgreSQL - recommended)
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/pixelcake

# Note: Per PostgreSQL devi prima creare il database:
# createdb pixelcake
# oppure: CREATE DATABASE pixelcake;

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# Secret key per JWT tokens (CAMBIA IN PRODUZIONE!)
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT algorithm (HS256 recommended)
ALGORITHM=HS256

# Token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Origini permesse (separati da virgola)
# Development: frontend Vite su porta 5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# Production: aggiungi il tuo dominio
# CORS_ORIGINS=["https://pixelcake.example.com","https://app.pixelcake.com"]

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server host. Nota: "python main.py" ascolta sempre e solo su 127.0.0.1,
# perché l'API non ha autenticazione; questo valore non lo cambia.
HOST=127.0.0.1

# Server port
PORT=8000

# Reload on code changes (solo development!)
RELOAD=true

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (opzionale - se vuoi salvare logs su file)
# LOG_FILE=logs/pixelcake.log

# =============================================================================
# FEATURES FLAGS (opzionali)
# =============================================================================

# Enable project versioning (history/undo)
ENABLE_PROJECT_VERSIONS=true

# Max versions per project (0 = unlimited)
MAX_PROJECT_VERSIONS=50

# =============================================================================
# TERRAFORM EXPORT (futuro)
# =============================================================================

# Terraform export directory
# TERRAFORM_OUTPUT_DIR=./terraform_exports

# Supported providers (comma separated)
# TERRAFORM_PROVIDERS=aws,azure,gcp,local

# =============================================================================
# EMAIL CONFIGURATION (futuro - per password reset, notifications)
# =============================================================================

# SMTP server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@pixelcake.example.com

# =============================================================================
# REDIS (futuro - per caching, sessions)
# =============================================================================

# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable debug mode (più verbose logging)
DEBUG=false

# Enable SQL query logging (mostra tutte le query)
SQL_ECHO=false

# =============================================================================
# PRODUCTION SECURITY
# =============================================================================

# HTTPS only (redirect HTTP to HTTPS)
# FORCE_HTTPS=true

# HSTS (HTTP Strict Transport Security) max age
# HSTS_MAX_AGE=31536000

# Rate limiting (requests per minute)
# RATE_LIMIT=100

# =============================================================================
# ESEMPIO COMPLETO DEVELOPMENT
# =============================================================================
# DATABASE_URL=sqlite+aiosqlite:///./database.db
# SECRET_KEY=dev-secret-key-not-for-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# CORS_ORIGINS=["http://localhost:5173"]
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true
# LOG_LEVEL=DEBUG

# =============================================================================
# ESEMPIO COMPLETO PRODUCTION
# =============================================================================
# DATABASE_URL=postgresql+asyncpg://pixelcake_user:secure_password@db.example.com:5432/pixelcake
# SECRET_KEY=wN8kQ5vX2mP9rJ4tL6hS3fG7dA1cZ0eY  # Generated with secrets.token_urlsafe(32)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# CORS_ORIGINS=["https://pixelcake.example.com"]
# HOST=0.0.0.0
# PORT=8000
# RELOAD=false
# LOG_LEVEL=WARNING
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=very-secure-admin-password
# ENABLE_PROJECT_VERSIONS=true
# MAX_PROJECT_VERSIONS=100
